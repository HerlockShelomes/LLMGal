# =============================================================================
# LLMGal 后端配置 —— 复制本文件为 .env，填入你自己的密钥即可运行
# 复制命令：  cp .env.example .env      （Windows: copy .env.example .env）
#
# 安全提示：.env 已被 .gitignore 排除，切勿提交到仓库。
# 所有密钥都从本机读取，不会上传任何地方。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、文本大模型（角色扮演对话）
# -----------------------------------------------------------------------------
# 可选：zhipu（默认，免费） / deepseek / qwen / custom
TEXT_PROVIDER=zhipu

# —— 方案 A：智谱 GLM-4.7-Flash（默认推荐，永久免费，200K 上下文）——
#   注册：https://open.bigmodel.cn  手机号即可，免信用卡
#   取 Key：控制台右上角「API Keys」
ZHIPU_API_KEY=a868fedc6b5a467ba2d682585b8c3b26.RwPNYXl23hBeu2R3

# —— 方案 B：DeepSeek（付费兜底，国内最低价档）——
#   注册：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# —— 方案 C：阿里百炼 通义千问（与下方语音共用同一账号，每月免费额度）——
#   注册：https://bailian.console.aliyun.com  支付宝登录，免信用卡
DASHSCOPE_API_KEY=sk-ws-H.PHHDXDR.XeKh.MEUCIQCs5b4KwC-krcQpsNfbCWXbsVBgSef9qiS04k7k4PDeywIgeNLtJ6IFGx6XNNDk1sJah7bslAa8ytzw7UzAXePCduU

# —— 可选覆盖（留空则使用上面 provider 的默认模型）——
# TEXT_BASE_URL=
# TEXT_MODEL=
# TEXT_API_KEY=

# 生成参数（一般不用改）
TEXT_TEMPERATURE=0.9
TEXT_MAX_TOKENS=1024
TEXT_TIMEOUT=60

# 多轮上下文最多携带多少条历史消息（含用户与助手双方，40 条约等于 20 轮）
CONTEXT_MAX_MESSAGES=40


# -----------------------------------------------------------------------------
# 二、语音合成（TTS）
# -----------------------------------------------------------------------------
# 可选：qwen（默认，每月 100 万字符免费） / volcengine（火山豆包，音质更好但计费）
TTS_PROVIDER=qwen

# —— qwen：阿里百炼 Qwen3-TTS，每月 100 万字符免费额度 ——
#   注意：与上面「方案 C 通义千问」共用 DASHSCOPE_API_KEY，填一次即可
TTS_QWEN_MODEL=qwen3-tts-flash
# 默认音色：Cherry(甜美女声) / Serena(御姐) / Ethan(温柔男声) / Chelsie(知性)
TTS_QWEN_VOICE=Serena
# 是否把情绪作为指令一起发送（需厂商支持，默认 0 关闭以免报错）
TTS_QWEN_USE_INSTRUCTIONS=0

# —— volcengine：火山豆包 TTS 2.0（仅当 TTS_PROVIDER=volcengine 时必填）——
#   注册：https://console.volcengine.com/speech  开通语音技术-大模型语音合成
TTS_VOLC_APPID=
TTS_VOLC_TOKEN=
TTS_VOLC_CLUSTER=volcano_tts


# -----------------------------------------------------------------------------
# 三、图像生成
# -----------------------------------------------------------------------------
# 可选：zhipu（默认，CogView-3-Flash 免费） / volcengine / seedream
IMAGE_PROVIDER=zhipu

# —— zhipu：CogView-3-Flash，免费出图 ——
#   与文本共用 ZHIPU_API_KEY，填一次即可
IMAGE_ZHIPU_MODEL=cogview-3-flash
IMAGE_ZHIPU_SIZE=1024x1024

# —— volcengine：火山视觉智能（仅当 IMAGE_PROVIDER=volcengine 时必填）——
#   控制台：https://console.volcengine.com/visual  密钥管理-访问密钥
IMAGE_VOLC_ACCESS_KEY=
IMAGE_VOLC_SECRET_KEY=

# —— seedream：火山方舟 Seedream（仅当 IMAGE_PROVIDER=seedream 时必填）——
#   控制台：https://console.volcengine.com/ark  开通后创建 API Key
ARK_API_KEY=
IMAGE_ARK_MODEL=doubao-seedream-4.0


# -----------------------------------------------------------------------------
# 四、服务与安全
# -----------------------------------------------------------------------------
# WebSocket 鉴权令牌：留空 = 不鉴权（开发模式，会打印警告）
# 强烈建议填写，否则任何能访问该端口的人都能消耗你的免费额度。
# 填写后前端需在连接地址上带 ?token=你的值，或在设置面板里填「后端鉴权令牌」。
WS_AUTH_TOKEN=

# 跨域白名单，逗号分隔。开发用 * ，生产请改成前端实际域名，例如 http://localhost:5173
CORS_ALLOW_ORIGINS=*

HOST=127.0.0.1
PORT=8000
