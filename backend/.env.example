# LLMGal 本地开发配置示例
#
# 复制为 backend/.env 后填写自己的开发/测试密钥：
#   macOS/Linux: cp backend/.env.example backend/.env
#   Windows:     copy backend\.env.example backend\.env
#
# .env 只应保留在本机，绝不可提交真实密钥。

# ---------------- 文本模型（必填） ----------------
# 可选：zhipu / deepseek / qwen / custom
TEXT_PROVIDER=zhipu
# ZHIPU_API_KEY=你的智谱开发密钥
# DEEPSEEK_API_KEY=你的 DeepSeek 开发密钥
# DASHSCOPE_API_KEY=你的阿里百炼开发密钥

# 可选覆盖默认模型和 OpenAI 兼容端点；一般无需填写。
# TEXT_MODEL=glm-5.3-flash
# TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# TEXT_API_KEY=仅在 TEXT_PROVIDER=custom 时使用
# TEXT_TEMPERATURE=0.9
# TEXT_MAX_TOKENS=1024
# TEXT_TIMEOUT=90

# ---------------- 语音合成（完整语音体验必填） ----------------
# 默认 qwen；也可改为 volcengine。
TTS_PROVIDER=qwen
# DASHSCOPE_API_KEY=你的阿里百炼开发密钥
# TTS_QWEN_MODEL=qwen3-tts-flash

# 火山 TTS（仅 TTS_PROVIDER=volcengine 时填写）
# TTS_VOLC_APPID=
# TTS_VOLC_TOKEN=
# TTS_VOLC_CLUSTER=volcano_tts

# ---------------- 图像生成（可选） ----------------
# 默认 zhipu。前端普通聊天默认不启用实时绘图，未配置图像密钥仍可体验文本、语音和静态情绪图。
IMAGE_PROVIDER=zhipu
# IMAGE_ZHIPU_API_KEY 通常直接复用 ZHIPU_API_KEY，无需单独设置。
# IMAGE_ZHIPU_MODEL=cogview-3-flash
# IMAGE_VOLC_ACCESS_KEY=
# IMAGE_VOLC_SECRET_KEY=
# ARK_API_KEY=

# ---------------- 本地服务（可选） ----------------
HOST=127.0.0.1
PORT=8000
CORS_ALLOW_ORIGINS=*
# 开发时如需自动重启可设为 1；普通部署建议保持 0。
DEV_RELOAD=0
# 留空表示本地开发不鉴权；设置后须在 frontend/.env.local 配置相同值。
# WS_AUTH_TOKEN=
