# 前端环境变量 —— 复制为 .env.local 后按需修改（.env.local 不会被提交）
# 复制命令：  cp .env.example .env.local      （Windows: copy .env.example .env.local）

# 后端 WebSocket 地址（默认 8000 端口，与 backend/.env 的 PORT 保持一致）
VITE_WS_URL=ws://localhost:8000/ws/chat

# 后端鉴权令牌：必须与 backend/.env 里的 WS_AUTH_TOKEN 完全一致。
# 如果后端没有设置 WS_AUTH_TOKEN（开发模式），这里留空即可。
VITE_WS_TOKEN=

# 后端 REST 地址（创建角色、音色试听、候选形象都走它）。
# Vite dev 在 5173、后端在 8000，不写全地址请求会打到 dev server 自己身上。
VITE_API_BASE=http://127.0.0.1:8000
